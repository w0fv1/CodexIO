{
  "name": "codexio",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "main": "dist/Server.js",
  "types": "dist/Server.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "tsup src/Server.ts --format esm --platform node --target node22 --out-dir bundle --no-splitting --sourcemap --clean",
    "dev": "tsx src/Server.ts",
    "test": "vitest run --pool=threads test/app.test.ts test/core.test.ts test/Updater.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1 -BuildOnly",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.178",
    "@larksuiteoapi/node-sdk": "^1.67.0",
    "@openai/codex": "^0.140.0",
    "cors": "^2.8.5",
    "eventemitter3": "^5.0.4",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "file-type": "^22.0.1",
    "imapflow": "^1.4.1",
    "inversify": "8.1.1",
    "mailparser": "^3.9.10",
    "marked": "^18.0.5",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "reflect-metadata": "0.2.2",
    "sanitize-html": "^2.17.5",
    "ws": "^8.21.0",
    "yaml": "^2.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
