{
  "name": "codexio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "codexio": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "tsup src/index.ts --format esm --platform node --target node22 --out-dir bundle --no-splitting --sourcemap --clean",
    "dev": "tsx src/index.ts dev",
    "login": "tsx src/index.ts login",
    "test": "vitest run src",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/build_windows_zip.ps1",
    "deploy": "powershell -ExecutionPolicy Bypass -File deploy.ps1"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.178",
    "@larksuiteoapi/node-sdk": "^1.67.0",
    "@openai/codex": "^0.140.0",
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "imapflow": "^1.4.1",
    "mailparser": "^3.9.10",
    "marked": "^18.0.5",
    "nodemailer": "^9.0.1",
    "sanitize-html": "^2.17.5",
    "ws": "^8.21.0",
    "yaml": "^2.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
